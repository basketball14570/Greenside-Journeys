# --- Supabase (auth, DB, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic Claude (screenshot OCR + condition narration) ---
ANTHROPIC_API_KEY=

# --- DataGolf (live leaderboard, course-fit, wave splits) ---
# https://datagolf.com/api-access — ~$30/mo
DATAGOLF_API_KEY=

# --- Tomorrow.io (course-level weather, 15-min granularity) ---
# https://www.tomorrow.io/weather-api/
TOMORROW_IO_API_KEY=

# --- The Odds API (sportsbook odds across DK, FD, etc.) ---
# https://the-odds-api.com/
THE_ODDS_API_KEY=

# --- Inbound email parsing (Postmark or SendGrid Inbound Parse) ---
# Used for the email-forward bet ingestion path. Webhook auths via HTTP
# Basic: user=postmark, password=POSTMARK_INBOUND_TOKEN.
POSTMARK_INBOUND_TOKEN=
# Hostname surfaced on /dashboard/account as bets+<token>@${DOMAIN}.
# Set to whatever domain Postmark Inbound is bound to.
POSTMARK_INBOUND_DOMAIN=greensidejourneys.com

# --- Push notifications (web push via VAPID) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@greensidejourneys.com

# --- Outbound webhooks (daily newsletter / alerts dispatch) ---
# Set any/all of these — the cron fans out to whichever are configured.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=

# --- Vercel cron auth ---
# When set, /api/cron/* routes require `Authorization: Bearer ${CRON_SECRET}`.
# Vercel cron sends this header automatically when configured in project settings.
CRON_SECRET=
